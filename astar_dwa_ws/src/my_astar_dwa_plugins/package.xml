<?xml version="1.0"?>
<package format="2">
  <name>my_astar_dwa_plugins</name>
  <version>0.0.0</version>
  <description>Improved A* and DWA plugins for ROS navigation system</description>
  <maintainer email="ubuntu2004@todo.todo">ubuntu2004</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  
  <!-- ROS Kinetic 依赖 -->
  <build_depend>nav_core</build_depend>
  <build_depend>costmap_2d</build_depend>
  <build_depend>tf</build_depend>
  <!-- ROS Kinetic 主要使用tf，而非tf2 -->
  <!-- <build_depend>tf2</build_depend> -->
  <!-- <build_depend>tf2_ros</build_depend> -->
  <!-- <build_depend>tf2_geometry_msgs</build_depend> -->
  <build_depend>roscpp</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>angles</build_depend>
  <!-- ROS Kinetic 使用OpenCV 3 -->
  <build_depend>libopencv-dev</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  
  <exec_depend>nav_core</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>tf</exec_depend>
  <!-- ROS Kinetic 主要使用tf，而非tf2 -->
  <!-- <exec_depend>tf2</exec_depend> -->
  <!-- <exec_depend>tf2_ros</exec_depend> -->
  <!-- <exec_depend>tf2_geometry_msgs</exec_depend> -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>angles</exec_depend>

  <export>
    <nav_core plugin="${prefix}/my_astar_dwa_plugins.xml" />
  </export>
</package>